<?xml version="1.0" encoding="utf-8"?>
<!--
  Tło ikony adaptacyjnej: gradient w kolorze primary aplikacji.

  Adaptive icon ma 108x108 dp, ale system może przyciąć je do dowolnego kształtu.
  Dlatego tło jest jednolitym gradientem bez detali — każde przycięcie wygląda poprawnie.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF3A6FD8" android:offset="0.0" />
                <item android:color="#FF2E5AAC" android:offset="0.55" />
                <item android:color="#FF11447F" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
